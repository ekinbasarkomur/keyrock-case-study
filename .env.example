# Copy to .env and adjust. .env is gitignored; this file is the tracked
# template and must never contain a real secret.
#
# Every value here has a working default in src/config.rs — the app runs with
# no .env at all.

# RUST_LOG-style filter. An explicit RUST_LOG in the environment overrides it.
ORDERBOOK_LOG_LEVEL=info

# Bind address. Use 0.0.0.0 inside a container; 127.0.0.1 on the host.
ORDERBOOK_HOST=127.0.0.1
ORDERBOOK_PORT=50051

# Traded pair the aggregator will stream once the feed/merge logic lands.
ORDERBOOK_PAIR=ethbtc
