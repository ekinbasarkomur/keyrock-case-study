# Copy to .env and adjust. Every value has a working default; none are required.

# RUST_LOG-style filter. An explicit RUST_LOG in the environment overrides it.
KEYROCK_LOG_LEVEL=info

# Bind address. Use 0.0.0.0 inside a container; 127.0.0.1 on the host.
KEYROCK_HOST=127.0.0.1
KEYROCK_PORT=50051

# Traded pair the aggregator will stream once the feed/merge logic lands.
KEYROCK_PAIR=ethbtc
